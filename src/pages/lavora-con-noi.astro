---
import Base from '../layouts/Base.astro';
import AperturaPagina from '../components/AperturaPagina.astro';
import IntestazioneSezione from '../components/IntestazioneSezione.astro';
import Pulsante from '../components/Pulsante.astro';
import Modulo from '../components/Modulo.astro';
import DatiStrutturati from '../components/DatiStrutturati.astro';
import { whatsappLink } from '../config/sito';

import fotoApertura from '../assets/foto/flotta-scania-colline.jpg';

const offriamo = [
  { titolo: 'Mezzi recenti e curati', testo: 'Trattori Scania e DAF di ultima generazione, tenuti in ordine e con manutenzione regolare.' },
  { titolo: 'Un lavoro specializzato', testo: 'Il trasporto di lamiere su piano inclinato è un mestiere preciso: ti formiamo sulle nostre procedure di carico e fissaggio.' },
  { titolo: 'Una squadra seria', testo: 'Un’azienda che rispetta chi guida: organizzazione chiara, viaggi pianificati, persone di riferimento raggiungibili.' },
];
const cerchiamo = ['Patente CE', 'CQC merci in corso di validità', 'Carta tachigrafica', 'Disponibilità a viaggi in tutta Italia', 'Esperienza con semirimorchi (preferibile)'];
---

<Base
  titolo="Lavora con noi: cerchiamo autisti patente CE con CQC"
  descrizione="Traspogru cerca autisti con patente CE e CQC merci per il trasporto di lamiere su semirimorchi a piano inclinato. Mezzi Scania e DAF recenti. Candidati online o su WhatsApp."
  headerSuHero
>
  <DatiStrutturati slot="head" tipo="lavoro" />
  <AperturaPagina
    etichetta="Lavora con noi"
    titolo="Guida un camion <em>di cui</em> andare fiero."
    sottotitolo="Cerchiamo autisti con patente CE e CQC merci. Se ami questo mestiere e vuoi farlo su mezzi all’altezza, parliamone."
    foto={fotoApertura}
    alt="Scania S 590 e Scania S 500 Traspogru in un’area di sosta tra le colline"
  >
    <div class="azioni">
      <Pulsante href="#candidatura">Candidati ora</Pulsante>
      <Pulsante href={whatsappLink('Buongiorno, vorrei candidarmi come autista. Patente: … CQC: … Esperienza: …')} variante="secondario" esterno>Scrivici su WhatsApp</Pulsante>
    </div>
  </AperturaPagina>

  <section class="blocco tema-chiaro taglio-alto">
    <div class="contenitore doppia">
      <div>
        <IntestazioneSezione numero="01" etichetta="Cosa offriamo" titolo="Perché <em>guidare</em> con noi." />
        <ul class="offriamo">
          {offriamo.map((o) => <li class="appare"><h3>{o.titolo}</h3><p>{o.testo}</p></li>)}
        </ul>
      </div>
      <div class="requisiti appare">
        <p class="etichetta">Chi cerchiamo</p>
        <h2 class="titolo-req">Autista<br />CE + CQC</h2>
        <ul>{cerchiamo.map((c) => <li>{c}</li>)}</ul>
        <p class="nota">Sede di lavoro: Castellammare di Stabia (NA). Viaggi su tutto il territorio nazionale.</p>
      </div>
    </div>
  </section>

  <section id="candidatura" class="blocco tema-scuro taglio-alto">
    <div class="contenitore stretto">
      <IntestazioneSezione numero="02" etichetta="Candidatura" titolo="Mandaci i tuoi <em>dati</em>." />
      <p class="lead intro">Compila il modulo: il messaggio si apre pronto in WhatsApp o nella tua email, e lì puoi allegare il curriculum. Ti ricontattiamo noi.</p>
      <Modulo tipo="candidatura" />
    </div>
  </section>
</Base>

<style>
  .azioni { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; margin-top: 0.5rem; }
  .blocco { padding-bottom: var(--sezione); scroll-margin-top: 40px; }
  .doppia { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem 5rem; align-items: start; }
  .offriamo { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  .offriamo li { border-left: 2px solid var(--accento); padding-left: 1.4rem; }
  .offriamo h3 { margin-bottom: 0.5rem; }
  .offriamo p { margin: 0; color: var(--testo-tenue); }
  .requisiti {
    background: var(--notte-900); color: #e9eef4; padding: 2.5rem;
    clip-path: polygon(0 0, calc(100% - 36px) 0, 100% 36px, 100% 100%, 0 100%);
  }
  .requisiti .etichetta { color: var(--giallo); margin-bottom: 1rem; }
  .titolo-req { font-size: clamp(2.6rem, 2rem + 2vw, 3.8rem); margin-bottom: 1.8rem; }
  .requisiti ul { list-style: none; margin: 0 0 1.8rem; padding: 0; display: grid; gap: 0.8rem; }
  .requisiti li { padding-left: 1.8rem; position: relative; }
  .requisiti li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 14px; height: 8px; background: var(--giallo); clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%); }
  .nota { margin: 0; font-size: var(--t-piccolo); color: #9fb1c6; }
  .stretto { max-width: 900px; }
  .intro { margin-bottom: 2.5rem; }
  @media (max-width: 899px) { .doppia { grid-template-columns: 1fr; } }
</style>

---
// Dato d'impatto. Con i dati generici scelti dal cliente si usano parole/sigle, non numeri inventati.
interface Props { valore: string; didascalia: string }
const { valore, didascalia } = Astro.props;
---

<div class="cifra appare">
  <span class="valore">{valore}</span>
  <span class="etichetta">{didascalia}</span>
</div>

<style>
  .cifra { display: grid; gap: 0.6rem; padding-top: 1.2rem; border-top: 2px solid var(--accento); }
  .valore { font-family: var(--f-display); font-weight: 800; font-size: clamp(2.6rem, 1.8rem + 3vw, 4.6rem); line-height: 0.9; text-transform: uppercase; }
</style>

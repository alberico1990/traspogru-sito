---
// Foto con bordo inferiore inclinato e leggero parallasse allo scroll (CSS scroll-driven).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; didascalia?: string; verso?: 'sinistra' | 'destra'; priorita?: boolean }
const { src, alt, didascalia, verso = 'destra', priorita = false } = Astro.props;
---

<figure class:list={['foto-inclinata', verso]}>
  <div class="cornice">
    <Image src={src} alt={alt} widths={[640, 1024, 1600, 2200]} sizes="(max-width: 900px) 100vw, 60vw"
      loading={priorita ? 'eager' : 'lazy'} fetchpriority={priorita ? 'high' : 'auto'} />
  </div>
  {didascalia && <figcaption class="etichetta">{didascalia}</figcaption>}
</figure>

<style>
  .foto-inclinata { margin: 0; }
  .cornice { overflow: hidden; aspect-ratio: 16 / 10; }
  .destra .cornice { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - var(--pendenza))); }
  .sinistra .cornice { clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--pendenza)), 0 100%); }
  .cornice :global(img) { width: 100%; height: 115%; object-fit: cover; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cornice :global(img) { animation-name: parallasse; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); }
    }
  }
  @keyframes parallasse { from { transform: translateY(-8%); } to { transform: translateY(0); } }
  figcaption { margin-top: 0.9rem; }
</style>

---
import Logo from '../assets/logo/logo-negativo.svg';
import Pulsante from './Pulsante.astro';

interface Props { suHero?: boolean }
const { suHero = false } = Astro.props;

const voci = [
  { href: '/specializzazione', testo: 'Specializzazione' },
  { href: '/settori', testo: 'Settori' },
  { href: '/flotta', testo: 'Flotta' },
  { href: '/lavori', testo: 'Lavori' },
  { href: '/lavora-con-noi', testo: 'Lavora con noi' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const percorso = Astro.url.pathname;
const relativo = base && (percorso === base || percorso.startsWith(`${base}/`)) ? percorso.slice(base.length) : percorso;
const attuale = relativo.replace(/(index)?\.html$/, '').replace(/\/$/, '');
const inHome = attuale === '';
const corrente = (href: string) => (href === '/' ? inHome : attuale === href) ? 'page' : undefined;
const icoCasa = 'M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-5.5h3V20h5V9.5';
---

<header class:list={['testata', 'tema-scuro', { 'su-hero': suHero }]}>
  <div class="contenitore riga">
    <a href="/" class="marchio" aria-label="Traspogru – home">
      <Logo aria-hidden="true" />
    </a>

    <nav aria-label="Principale" class="nav-desktop">
      <ul>
        <li><a href="/" class="voce-home" aria-current={corrente('/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icoCasa} /></svg>Home
        </a></li>
        {voci.map((v) => (
          <li><a href={v.href} aria-current={corrente(v.href)}>{v.testo}</a></li>
        ))}
      </ul>
    </nav>

    <div class="azioni">
      {!inHome && (
        <a href="/" class="torna-home" aria-label="Torna alla home">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icoCasa} /></svg><span>Home</span>
        </a>
      )}
      <Pulsante href="/contatti" variante="primario" piccolo>Preventivo</Pulsante>
      <button class="apri-menu" popovertarget="menu-mobile" aria-label="Apri il menu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menu mobile con Popover API nativa: nessun JavaScript -->
  <nav id="menu-mobile" popover aria-label="Menu" class="menu-mobile tema-scuro">
    <button class="chiudi" popovertarget="menu-mobile" popovertargetaction="hide" aria-label="Chiudi il menu">×</button>
    <ul>
      {[{ href: '/', testo: 'Home' }, ...voci, { href: '/contatti', testo: 'Contatti' }].map((v, i) => (
        <li style={`--i:${i}`}>
          <a href={v.href} aria-current={corrente(v.href)}>
            <span class="etichetta">{String(i + 1).padStart(2, '0')}</span>{v.testo}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .testata {
    position: sticky; top: 0; z-index: 50;
    background: rgb(7 20 39 / 0.94);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--linea);
  }
  /* Sopra l'hero l'header nasce trasparente e diventa pieno scorrendo (scroll-driven, niente JS) */
  .su-hero { position: fixed; inset: 0 0 auto; background: linear-gradient(180deg, rgb(4 11 22 / 0.78), rgb(4 11 22 / 0)); border-color: transparent; backdrop-filter: none; }
  @supports (animation-timeline: scroll()) {
    .su-hero { animation-name: testata-piena; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); animation-range: 0 40vh; }
  }
  @keyframes testata-piena {
    to { background: rgb(7 20 39 / 0.94); border-color: var(--linea); backdrop-filter: blur(14px) saturate(1.4); }
  }

  .riga { display: flex; align-items: center; gap: 2rem; height: 76px; }
  .marchio { flex-shrink: 0; }
  .marchio :global(svg) { height: 58px; width: auto; }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-desktop a {
    position: relative; display: block; padding: 0.5rem 0.8rem;
    text-decoration: none; font-weight: 500; font-size: 0.95rem; color: var(--testo-tenue);
    transition: color 0.2s;
  }
  .nav-desktop a::after {
    content: ''; position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.2rem; height: 2px;
    background: var(--giallo); transform: scaleX(0) skewX(-30deg); transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav-desktop a:hover, .nav-desktop a[aria-current='page'] { color: var(--testo); }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current='page']::after { transform: scaleX(1) skewX(-30deg); }

  .azioni { display: flex; align-items: center; gap: 0.75rem; }
  .voce-home { display: flex !important; align-items: center; gap: 0.4rem; }
  .voce-home svg, .torna-home svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  /* pulsante Home visibile solo su telefono/tablet nelle pagine interne */
  .torna-home {
    display: none; align-items: center; gap: 0.45rem; height: 44px; padding: 0 0.85rem;
    border: 1px solid var(--linea); color: var(--testo); text-decoration: none;
    font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .torna-home:hover { border-color: var(--giallo); color: var(--giallo); }
  .apri-menu {
    display: none; width: 44px; height: 44px; border: 1px solid var(--linea); background: transparent;
    cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 7px;
  }
  .apri-menu span { display: block; width: 20px; height: 2px; background: var(--testo); }
  .apri-menu span:last-child { width: 13px; margin-left: 7px; }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .azioni { margin-left: auto; }
    .apri-menu { display: flex; }
    .torna-home { display: flex; }
  }
  @media (max-width: 480px) {
    .torna-home span { display: none; }
    .torna-home { padding: 0; width: 44px; justify-content: center; }
    .marchio :global(svg) { height: 46px; }
    .azioni :global(.pulsante) { display: none; }
  }

  /* Menu mobile a tutto schermo */
  .menu-mobile {
    inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; margin: 0; border: 0;
    padding: 6rem var(--gutter) 3rem; background: var(--notte-950);
    background-image: radial-gradient(circle at 85% 10%, rgb(90 182 214 / 0.18), transparent 45%);
  }
  .menu-mobile ul { list-style: none; margin: 0; padding: 0; }
  .menu-mobile li { border-bottom: 1px solid var(--linea); }
  .menu-mobile a {
    display: flex; align-items: baseline; gap: 1rem; padding: 0.9rem 0; text-decoration: none;
    font-family: var(--f-display); font-weight: 800; font-size: clamp(2rem, 9vw, 3.2rem); text-transform: uppercase; line-height: 1;
  }
  .menu-mobile a[aria-current='page'] { color: var(--giallo); }
  .chiudi {
    position: absolute; top: 1rem; right: var(--gutter); width: 48px; height: 48px;
    background: transparent; border: 1px solid var(--linea); color: var(--testo); font-size: 2rem; line-height: 1; cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu-mobile:popover-open li { animation: voce-entra 0.5s var(--ease-out) both; animation-delay: calc(var(--i) * 45ms); }
  }
  @keyframes voce-entra { from { opacity: 0; transform: translateX(-24px); } }
</style>
